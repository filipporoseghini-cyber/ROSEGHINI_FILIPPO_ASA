# ============================================================================
#  CONFIG AGENTE BDI (agente3) — rename to .env and fill in your values
# ============================================================================

# ===================== SERVER DI GIOCO =====================
# --- ONLINE: server UniTN (requires VPN GlobalProtect) ---
#HOST=https://deliveroojs.bears.disi.unitn.it
#TOKEN=<your_jwt_token>

# --- LOCALE: game server on localhost:8080 ---
HOST=http://localhost:8080
TOKEN=<your_jwt_token>

SENSING_RADIUS=5

# ===================== PDDL (optional) =====================
# Task-level PDDL planning (pickup & deliver). Requires planning.domains:5001.
# Falls back to A* if unreachable.
#USE_PDDL_DELIVERY=true
# Navigation via PDDL instead of local A*:
#USE_PDDL_PLANNER=true
