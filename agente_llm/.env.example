# ============================================================================
#  CONFIG AGENTE LLM (agente_llm) — rename to .env and fill in your values
# ============================================================================

# ===================== SERVER DI GIOCO =====================
# Use a DIFFERENT token from agente3 — they are two distinct players.
HOST=http://localhost:8080
TOKEN=<your_jwt_token>

# --- ONLINE: server UniTN (requires VPN) ---
#HOST=https://deliveroojs.bears.disi.unitn.it
#TOKEN=<your_jwt_token>

SENSING_RADIUS=5

# ===================== PROVIDER LLM =====================
# --- UniTN (requires VPN) ---
LITELLM_BASE_URL=https://llm.bears.disi.unitn.it/v1
LITELLM_API_KEY=<your_litellm_api_key>

# --- Local LLM: LM Studio / Ollama ---
#LITELLM_BASE_URL=http://localhost:1234/v1
#LITELLM_API_KEY=lm-studio

# --- OpenAI cloud ---
#LITELLM_BASE_URL=https://api.openai.com/v1
#LITELLM_API_KEY=<your_openai_key>

# ===================== MODEL =====================
# Available on UniTN API:
#   llama-3.3-70b-lmstudio   — 70B, more capable but slow (~5-8s/call)
#   gemma-3-27b-lmstudio     — 27B, good speed/quality balance
#   qwen/qwen3.6-35b-a3b     — MoE 35B/3.6B active, fast and strong (RECOMMENDED)
LOCAL_MODEL=llama-3.3-70b-lmstudio

# ===================== BEHAVIOUR =====================
# LLM_LAZY=true (default) = deterministic game loop when no special missions active
#LLM_LAZY=true
